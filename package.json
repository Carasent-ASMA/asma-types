{
    "name": "asma-types",
    "version": "2.8.1",
    "description": "shared ts asma types",
    "main": "lib/index.js",
    "files": [
        "lib/**/*"
    ],
    "type": "module",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "require": "./lib/index.js",
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "author": "ie",
    "license": "MIT",
    "scripts": {
        "build": "pnpm ts:check",
        "ts:check": "tsc && tsc -p tsconfig.spec.json",
        "test": "node --import tsx --test \"src/**/*.test.ts\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Carasent-ASMA/asma-types"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "tsx": "^4.23.0",
        "typescript": "7.0.2"
    }
}
